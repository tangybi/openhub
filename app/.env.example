# 复制为 .env 并填入密钥：cp .env.example .env

# LLM（DeepSeek，必需：摘要、热度分、Agent 问答）
DEEPSEEK_API_KEY=

# 云端数据库（Neon Postgres + pgvector，必需：用户/会话/消息 + RAG + mem0 记忆）
# Neon 项目 → Connection Details → 复制连接串（postgresql://...）
DATABASE_URL=

# embedding 向量化（硅基流动 BGE-M3，必需：RAG 检索 + mem0 记忆的向量化）
# DeepSeek 无 embedding 接口，需单独配一个 OpenAI 兼容 embedding 服务
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 对象存储（Cloudflare R2，粘贴功能必需）
# R2 控制台 → 管理 R2 API 令牌 → 创建令牌，拿到 Access Key ID / Secret Access Key
# R2_ENDPOINT 形如 https://<accountid>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL：绑到 bucket 的自定义域名根，如 https://pastes.example.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=pastes
R2_PUBLIC_BASE_URL=https://pastes.example.com

# 应用公开访问基础地址（短链接前缀）。留空按请求 Host 推导
APP_BASE_URL=
